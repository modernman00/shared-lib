#!/usr/bin/env php
<?php

declare(strict_types=1);

// Usage: vendor/bin/verify-must-haves [target_directory]
$autoloads = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
foreach ($autoloads as $a) {
    if (is_file($a)) {
        require $a;
        break;
    }
}

$dir = $argv[1] ?? getcwd();
$result = \Src\Quality\EngineeringMustHaves::report(\Src\Quality\EngineeringMustHaves::scan((string) $dir), (string) $dir);
exit($result['exit']);
